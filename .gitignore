# Don't ignore important config
!.env.example

# OSRM response cache for tool/build_route_geometry.py. A fetch accelerator so
# a rebuild after a rule change does not re-request ~1580 routes; it is not
# product data and data/route_geometry.json is the committed artefact.
data/.osrm_raw_cache.json
data/.road_network_cache.json
data/taxi_pairs_sample.json
src/backend/tool/_bytesedit.py

# Derived routing graphs. Rebuilt from the local OSM extracts by
#   python src/backend/tool/build_road_graph.py   (needs ~/Downloads/roads/roads.gpkg)
#   python src/backend/tool/build_rail_graph.py   (needs ~/Downloads/rails/export.geojson)
# road_graph.npz alone is 153 MB, rail_graph.npz 0.6 MB. Neither belongs in git;
# the BUILD SCRIPTS are committed so the graphs are reproducible.
data/road_graph.npz
data/rail_graph.npz

# Rust
rust/target/
**/*.rs.bk

# SvelteKit
frontend/.svelte-kit/
data/bizerteconnect_cache.json

# Raw upstream scrapes. These are INPUTS to the committed converters
# (scripts/convert_all_routes.py, scripts/scrape_station_details.py) and are
# regenerable by re-running the scrapers. They are large (21 MB / 1.7 MB) and
# are upstream third-party content, so they are not redistributed here.
scripts/tunismapper_all_routes_stops.json
scripts/tunismapper_station_details.json
src/mobile/tool/osm_nodes_cache.json

# Claude Code local project state (may hold personal settings)
.claude/

# Ad-hoc debugging scripts written at the repo root during investigation.
# These are scratch files, not part of the build.
tmp_*.py
/tmp_*.json

# Local environment files for docker compose
.env
